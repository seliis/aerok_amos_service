datasource db {
  provider = "sqlite"
  url      = "file:prisma/database.db"
}
 
generator db {
  provider = "go run github.com/steebchen/prisma-client-go"
  output = "prisma"
}
 
model Currency {
    @@map("currencies")

    Code String @id @map("code")
    Name String @unique @map("name")
    Base Int @map("base")

    ExchangeRates ExchangeRate[]
}

model ExchangeRate {
    @@map("exchange_rates")
    @@unique([CurrencyCode, Date])

    ID String @id @default(uuid()) @map("id")
    CurrencyCode String @map("currency_code")
    Date String @map("date")
    Rate Float @map("rate")

    Currency Currency @relation(fields: [CurrencyCode], references: [Code])
}

model FlightSchedule {
    @@map("flight_schedules")
    @@unique([ScheduledDateDeparture, FlightNumber])

    ID String @id @default(uuid()) @map("id")
    FlightNumber Int @map("flight_number")
    FlightSuffix String @map("flight_suffix")
    CarrierCode String @map("carrier_code")
    ServiceTypeCode String @map("service_type_code")
    AircraftRegistration String @map("aircraft_registration")
    ScheduledDateDeparture String @map("scheduled_date_departure")
    ScheduledTimeDeparture String @map("scheduled_time_departure")
    DepartureAirportCode String @map("departure_airport_code")
    ScheduledDateArrival String @map("scheduled_date_arrival")
    ScheduledTimeArrival String @map("scheduled_time_arrival")
    ArrivalAirportCode String @map("arrival_airport_code")
    EstimatedLegDuration Int @map("estimated_leg_duration")
}